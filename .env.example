# Copy to .env.local and adjust. Restart `npm run dev` after changing anything here.

# Real API. Set this to call the link-organizer-api server; leave it unset or empty to use
# the mock API (src/services/link-mgmnt-services.ts, backed by mock-data/).
# VITE_API_BASE_URL=http://127.0.0.1:3000

# Mock API only (ignored when VITE_API_BASE_URL is set).
VITE_MOCK_MIN_DELAY_MS=3000
VITE_MOCK_MAX_DELAY_MS=6000
# 0 = never fail, 1 = always fail. Failures use the transient errors in mock-data/errors.json.
VITE_MOCK_ERROR_RATE=0.1
