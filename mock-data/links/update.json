  "request": {
    "params": { "id": "9b2e7a10-4c3d-4e5f-8a6b-7c8d9e0f1a04" },
    "query": null,
    "body": {
      "fields": {
        "title": "Link.title",
        "url": "Link.url",
        "description": "Link.description",
        "notes": "Link.notes",
        "categoryId": "Link.categoryId",
        "rating": "Link.rating"
      },
      "example": { "rating": 5 }
    }
  },
  "responses": [
    {
      "status": 200,
      "description": "OK. Returns the updated link.",
